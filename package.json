{
  "name": "atl-transit-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Atlanta Transit — unofficial PWA for real-time MARTA bus tracking",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --filter @atl-transit/web dev",
    "build": "pnpm --filter @atl-transit/web build",
    "preprocess-gtfs": "pnpm --filter @atl-transit/web preprocess-gtfs",
    "lint": "eslint .",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.10.0",
    "eslint-plugin-boundaries": "^5.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
